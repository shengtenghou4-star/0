from __future__ import annotations

import argparse
import hashlib
import itertools
import json
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any

import numpy as np
from scipy.io import loadmat

LAGS = (0, 1, 2, 3, 5, 8, 13)
NEURAL_LAGS = (0, 1, 3, 8)
ENDPOINTS = {
    "ANY_TRANSITION_10": ("ANY", 10),
    "ANY_TRANSITION_20": ("ANY", 20),
    "TURN_INITIATION_20": ("TURN", 20),
}
PRIMARY = "TURN_INITIATION_20"
SECONDARY = "ANY_TRANSITION_20"
SHORT = "ANY_TRANSITION_10"
SOURCES = ("REAL", "TIME_REVERSED", "PHASE_SCRAMBLED", "CHANNEL_BLOCK_PERMUTED")
CONTROLS = SOURCES[1:]
STATES = ("QUIET", "FORWARD", "REVERSE", "TURN_LEFT", "TURN_RIGHT")
FAMILIES = ("P", "PD")
KS = (2, 4)
LAMBDAS = (0.995, 0.999)
BASE_ALPHAS = (10.0, 100.0)
NEURAL_ALPHAS = (10.0, 100.0)
WARMUP_FRACTION = 0.40
EMBARGO = 24
STATE_EMA_SPAN = 5
PERSIST = 3
RECOMPUTE_EVERY = 25
EPS = 1e-12
INTERCEPT_PRIOR = 1e-9
INNER_SAFETY = 1.10
PREREG_COMMIT = "b827855f9aa03e07fb68bb186334466f09e9655c"
DATA_SHA256 = "144126ee9a49d311c3393deea434e1a0963d55de35318e25d98d48f9c175250a"


def write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True, allow_nan=False), encoding="utf-8")


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def parse_dataset_list(root: Path) -> list[tuple[str, int | None]]:
    matches = sorted(root.rglob("*_datasets.txt"))
    if len(matches) != 1:
        raise RuntimeError(f"expected one dataset list under {root}, got {matches}")
    rows: list[tuple[str, int | None]] = []
    for raw in matches[0].read_text(encoding="utf-8").splitlines():
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        toks = line.split()
        rows.append((toks[0], int(toks[1]) if len(toks) == 2 else None))
    if len(rows) != 4:
        raise RuntimeError(f"expected four training recordings, got {rows}")
    return rows


def centerline_curvature_metric(folder: Path, heat: dict[str, Any]) -> np.ndarray:
    center = loadmat(folder / "centerline.mat")
    cl = np.rollaxis(np.asarray(center["centerline"], dtype=float), 2, 0)
    npoints = cl.shape[1]
    d = np.diff(cl, axis=1)
    tangent = np.unwrap(np.arctan2(-d[:, :, 1], d[:, :, 0]), axis=-1)
    curvature = np.unwrap(np.diff(tangent, axis=1), axis=-1) * npoints
    metric = np.mean(curvature[:, 15:80], axis=1)
    mu = float(np.mean(metric))
    sd = float(np.std(metric))
    if sd > 0:
        metric[np.abs(metric - mu) > 6.0 * sd] = np.nan
    bad = ~np.isfinite(metric)
    good = ~bad
    if np.any(bad):
        if not np.any(good):
            raise RuntimeError(f"no finite curvature in {folder}")
        metric[bad] = np.interp(np.flatnonzero(bad), np.flatnonzero(good), metric[good])
    cl_time = np.asarray(heat["clTime"], dtype=float).squeeze()
    vol_time = np.asarray(heat["hasPointsTime"], dtype=float).squeeze()
    idx = np.rint(np.interp(vol_time, cl_time, np.arange(cl_time.size))).astype(int)
    idx = np.clip(idx, 0, metric.size - 1)
    return metric[idx]


@dataclass
class RecordBase:
    record_id: str
    frames: np.ndarray
    velocity: np.ndarray
    curvature: np.ndarray
    raw_selected: np.ndarray
    warmup_boundary: int
    selected_neurons: int
    warmup_median: np.ndarray
    warmup_scale: np.ndarray


def load_record(root: Path, record_id: str, cutoff: int | None) -> RecordBase:
    folders = sorted(p for p in root.rglob(f"{record_id}_MS") if p.is_dir())
    if len(folders) != 1:
        raise RuntimeError(f"expected one folder for {record_id}, got {folders}")
    folder = folders[0]
    heat_path = folder / "heatDataMS.mat"
    if not heat_path.exists():
        heat_path = folder / "heatData.mat"
    heat = loadmat(heat_path)
    behavior = heat["behavior"][0, 0]
    velocity = np.asarray(behavior["v"], dtype=float)[:, 0]
    curvature = centerline_curvature_metric(folder, heat)
    ratio = np.asarray(heat["Ratio2"], dtype=float)
    n = min(velocity.size, curvature.size, ratio.shape[1])
    cutoff_i = n - 1 if cutoff is None else min(int(cutoff), n - 1)
    frames_all = np.arange(cutoff_i + 1, dtype=int)
    velocity = velocity[: cutoff_i + 1]
    curvature = curvature[: cutoff_i + 1]
    ratio = ratio[:, : cutoff_i + 1]
    valid = np.isfinite(velocity) & np.isfinite(curvature) & (np.mean(np.isfinite(ratio), axis=0) > 0.5)
    frames = frames_all[valid]
    velocity = velocity[valid]
    curvature = curvature[valid]
    ratio_tn = ratio[:, valid].T
    if frames.size < 100:
        raise RuntimeError(f"too few usable frames in {record_id}: {frames.size}")
    boundary = int(np.floor(frames[0] + WARMUP_FRACTION * (frames[-1] - frames[0])))
    warm_mask = frames <= boundary
    warm = ratio_tn[warm_mask]
    finite_rate = np.mean(np.isfinite(warm), axis=0)
    med = np.nanmedian(warm, axis=0)
    mad = np.nanmedian(np.abs(warm - med), axis=0)
    keep = (finite_rate >= 0.80) & np.isfinite(med) & np.isfinite(mad) & (mad > EPS)
    if np.count_nonzero(keep) < max(KS):
        raise RuntimeError(f"too few selected neurons in {record_id}")
    selected = ratio_tn[:, keep]
    med = med[keep]
    scale = 1.4826 * mad[keep]
    scale[scale < EPS] = 1.0
    return RecordBase(record_id, frames, velocity, curvature, selected, boundary, int(np.count_nonzero(keep)), med, scale)


def load_records(root: Path) -> list[RecordBase]:
    return [load_record(root, rid, cutoff) for rid, cutoff in parse_dataset_list(root)]


def causal_ema(x: np.ndarray, span: int) -> np.ndarray:
    a = 2.0 / (span + 1.0)
    out = np.empty_like(x, dtype=float)
    out[0] = x[0]
    for i in range(1, x.size):
        out[i] = (1.0 - a) * out[i - 1] + a * x[i]
    return out


@dataclass
class BehaviorState:
    v_ema: np.ndarray
    k_ema: np.ndarray
    state: np.ndarray
    duration: np.ndarray
    transition_onsets: dict[int, tuple[str, str]]
    movement_threshold: float
    turn_threshold: float
    v_center: float
    v_scale: float
    k_center: float
    k_scale: float


def robust_center_scale(x: np.ndarray) -> tuple[float, float]:
    med = float(np.median(x))
    mad = float(np.median(np.abs(x - med)))
    scale = max(1.4826 * mad, EPS)
    return med, scale


def derive_behavior_state(rec: RecordBase) -> BehaviorState:
    v = causal_ema(rec.velocity, STATE_EMA_SPAN)
    k = causal_ema(rec.curvature, STATE_EMA_SPAN)
    warm = rec.frames <= rec.warmup_boundary
    v_thr = max(float(np.quantile(np.abs(v[warm]), 0.35)), EPS)
    moving_warm = warm & (np.abs(v) >= v_thr)
    pool = np.abs(k[moving_warm]) if np.count_nonzero(moving_warm) >= 20 else np.abs(k[warm])
    k_thr = max(float(np.quantile(pool, 0.75)), EPS)
    state = np.empty(rec.frames.size, dtype=object)
    for i in range(rec.frames.size):
        if abs(v[i]) < v_thr:
            s = "QUIET"
        elif k[i] >= k_thr:
            s = "TURN_LEFT"
        elif k[i] <= -k_thr:
            s = "TURN_RIGHT"
        elif v[i] > 0:
            s = "FORWARD"
        else:
            s = "REVERSE"
        state[i] = s
    duration = np.ones(rec.frames.size, dtype=int)
    for i in range(1, rec.frames.size):
        if rec.frames[i] == rec.frames[i - 1] + 1 and state[i] == state[i - 1]:
            duration[i] = duration[i - 1] + 1
    fmap = {int(f): i for i, f in enumerate(rec.frames)}
    onsets: dict[int, tuple[str, str]] = {}
    for f in rec.frames:
        f = int(f)
        req_old = [f - j for j in range(1, PERSIST + 1)]
        req_new = [f + j for j in range(PERSIST)]
        if any(x not in fmap for x in req_old + req_new):
            continue
        old = str(state[fmap[f - 1]])
        new = str(state[fmap[f]])
        if old == new:
            continue
        if all(str(state[fmap[x]]) == old for x in req_old) and all(str(state[fmap[x]]) == new for x in req_new):
            onsets[f] = (old, new)
    vc, vs = robust_center_scale(v[warm])
    kc, ks = robust_center_scale(k[warm])
    return BehaviorState(v, k, state, duration, onsets, v_thr, k_thr, vc, vs, kc, ks)


def stable_seed(record_id: str, source: str) -> int:
    digest = hashlib.sha256(f"BIO001-S39::{record_id}::{source}".encode()).digest()
    return int.from_bytes(digest[:8], "big") % (2**32)


def fill_channels(raw: np.ndarray) -> np.ndarray:
    out = np.asarray(raw, dtype=float).copy()
    med = np.nanmedian(out, axis=0)
    med[~np.isfinite(med)] = 0.0
    bad = ~np.isfinite(out)
    if np.any(bad):
        out[bad] = np.take(med, np.nonzero(bad)[1])
    return out


def transform_neural(rec: RecordBase, source: str) -> tuple[RecordBase, dict[str, Any]]:
    raw = fill_channels(rec.raw_selected)
    seed = stable_seed(rec.record_id, source)
    rng = np.random.default_rng(seed)
    if source == "REAL":
        transformed = raw
    elif source == "TIME_REVERSED":
        transformed = raw[::-1].copy()
    elif source == "PHASE_SCRAMBLED":
        transformed = np.empty_like(raw)
        n = raw.shape[0]
        for j in range(raw.shape[1]):
            spec = np.fft.rfft(raw[:, j])
            phases = rng.uniform(0.0, 2.0 * np.pi, size=spec.size)
            phases[0] = 0.0
            if n % 2 == 0:
                phases[-1] = 0.0
            z = np.abs(spec) * np.exp(1j * phases)
            z[0] = spec[0]
            if n % 2 == 0:
                z[-1] = spec[-1]
            transformed[:, j] = np.fft.irfft(z, n=n)
    elif source == "CHANNEL_BLOCK_PERMUTED":
        transformed = raw.copy()
        channel_block, time_block = 16, 32
        blocks = [np.arange(i, min(i + channel_block, raw.shape[1])) for i in range(0, raw.shape[1], channel_block)]
        for t0 in range(0, raw.shape[0], time_block):
            order = rng.permutation(len(blocks))
            perm = np.concatenate([blocks[i] for i in order])
            transformed[t0:t0 + time_block] = raw[t0:t0 + time_block, perm]
    else:
        raise ValueError(source)
    warm = rec.frames <= rec.warmup_boundary
    med = np.median(transformed[warm], axis=0)
    mad = np.median(np.abs(transformed[warm] - med), axis=0)
    scale = 1.4826 * mad
    scale[~np.isfinite(scale) | (scale < EPS)] = 1.0
    out = replace(rec, raw_selected=transformed, warmup_median=med, warmup_scale=scale)
    return out, {
        "source": source,
        "seed": int(seed),
        "shape": [int(x) for x in transformed.shape],
        "finite": bool(np.all(np.isfinite(transformed))),
        "offline_negative_control": source != "REAL",
    }


def align_basis(previous: np.ndarray, candidate: np.ndarray) -> np.ndarray:
    k = previous.shape[1]
    best_perm: tuple[int, ...] | None = None
    best_score = -np.inf
    for perm in itertools.permutations(range(k)):
        score = float(sum(abs(np.dot(previous[:, i], candidate[:, perm[i]])) for i in range(k)))
        if score > best_score + 1e-15 or (abs(score - best_score) <= 1e-15 and (best_perm is None or perm < best_perm)):
            best_score, best_perm = score, perm
    assert best_perm is not None
    out = candidate[:, best_perm].copy()
    for i in range(k):
        dot = float(np.dot(previous[:, i], out[:, i]))
        if dot < 0:
            out[:, i] *= -1
        elif dot == 0:
            j = int(np.argmax(np.abs(out[:, i])))
            if out[j, i] < 0:
                out[:, i] *= -1
    return out


def deterministic_basis(cov: np.ndarray, k: int, previous: np.ndarray | None = None) -> np.ndarray:
    vals, vecs = np.linalg.eigh(cov)
    basis = vecs[:, np.argsort(vals)[::-1][:k]].copy()
    for i in range(basis.shape[1]):
        j = int(np.argmax(np.abs(basis[:, i])))
        if basis[j, i] < 0:
            basis[:, i] *= -1
    return align_basis(previous, basis) if previous is not None else basis


@dataclass
class NeuralScores:
    scores: np.ndarray
    basis_updates: int


def compute_online_scores(rec: RecordBase, lam: float) -> NeuralScores:
    raw = rec.raw_selected
    warm = rec.frames <= rec.warmup_boundary
    warm_raw = np.where(np.isfinite(raw[warm]), raw[warm], rec.warmup_median[None, :])
    z_warm = (warm_raw - rec.warmup_median[None, :]) / rec.warmup_scale[None, :]
    mean = rec.warmup_median.copy()
    var = np.square(rec.warmup_scale)
    cov = np.cov(z_warm, rowvar=False, bias=True)
    basis = deterministic_basis(cov, max(KS))
    scores = np.full((rec.frames.size, max(KS)), np.nan)
    scores[warm] = z_warm @ basis
    counter = updates = 0
    for i in np.flatnonzero(~warm):
        x = np.where(np.isfinite(raw[i]), raw[i], mean)
        z = (x - mean) / np.sqrt(np.maximum(var, EPS))
        scores[i] = z @ basis
        delta = x - mean
        mean = lam * mean + (1.0 - lam) * x
        var = lam * var + (1.0 - lam) * np.square(delta)
        cov = lam * cov + (1.0 - lam) * np.outer(z, z)
        counter += 1
        if counter % RECOMPUTE_EVERY == 0:
            basis = deterministic_basis(cov, max(KS), basis)
            updates += 1
    if not np.all(np.isfinite(scores)):
        raise RuntimeError(f"nonfinite scores {rec.record_id} {lam}")
    return NeuralScores(scores, updates)


@dataclass
class EventSet:
    current_frames: np.ndarray
    reveal_frames: np.ndarray
    X: np.ndarray
    y: np.ndarray
    warmup_mask: np.ndarray
    scored_mask: np.ndarray


def behavior_features(rec: RecordBase, bs: BehaviorState, f: int) -> np.ndarray | None:
    fmap = {int(x): i for i, x in enumerate(rec.frames)}
    req = [f - lag for lag in LAGS]
    universal = req + [f - lag - 1 for lag in NEURAL_LAGS]
    if any(x not in fmap for x in universal):
        return None
    idxs = [fmap[x] for x in req]
    vz = np.asarray([(bs.v_ema[i] - bs.v_center) / bs.v_scale for i in idxs])
    kz = np.asarray([(bs.k_ema[i] - bs.k_center) / bs.k_scale for i in idxs])
    diff = np.concatenate([vz[0] - vz[1:], kz[0] - kz[1:]])
    onehot = np.zeros(len(STATES), dtype=float)
    onehot[STATES.index(str(bs.state[fmap[f]]))] = 1.0
    duration = min(int(bs.duration[fmap[f]]), 50) / 50.0
    recent10 = sum(1 for g in bs.transition_onsets if f - 10 < g <= f)
    recent20 = sum(1 for g in bs.transition_onsets if f - 20 < g <= f)
    feat = np.concatenate([vz, kz, diff, onehot, np.array([duration, recent10 / 5.0, recent20 / 10.0])])
    return feat if np.all(np.isfinite(feat)) else None


def neural_features(rec: RecordBase, scores: np.ndarray, f: int, family: str, k: int) -> np.ndarray | None:
    fmap = {int(x): i for i, x in enumerate(rec.frames)}
    req = [f - lag for lag in NEURAL_LAGS]
    if any(x not in fmap for x in req):
        return None
    if family == "PD" and any((x - 1) not in fmap for x in req):
        return None
    parts: list[np.ndarray] = []
    for x in req:
        i = fmap[x]
        s = scores[i, :k]
        parts.append(s)
        if family == "PD":
            parts.append(s - scores[fmap[x - 1], :k])
    out = np.concatenate(parts)
    return out if np.all(np.isfinite(out)) else None


def event_label(bs: BehaviorState, f: int, kind: str, horizon: int) -> int:
    for g, (_old, new) in bs.transition_onsets.items():
        if f < g <= f + horizon:
            if kind == "ANY" or (kind == "TURN" and new in ("TURN_LEFT", "TURN_RIGHT")):
                return 1
    return 0


def build_events(
    rec: RecordBase,
    bs: BehaviorState,
    endpoint: string,
    scores: np.ndarray | None = None,
    family: str | None = None,
    k: int | None = None,
) -> EventSet:
    kind, horizon = ENDPOINTS[endpoint]
