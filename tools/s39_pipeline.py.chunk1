    for f in rec.frames:
        f = int(f)
        req_old = [f - j for j in range(1, PERSIST + 1)]
        req_new = [f + j for j in range(PERSIST)]
        if any(x not in fmap for x in req_old + req_new):
            continue
        old = str(state[fmap[f - 1]])
        new = str(state[fmap[f]])
        if old == new:
            continue
        if all(str(state[fmap[x]]) == old for x in req_old) and all(str(state[fmap[x]]) == new for x in req_new):
            onsets[f] = (old, new)
    vc, vs = robust_center_scale(v[warm])
    kc, ks = robust_center_scale(k[warm])
    return BehaviorState(v, k, state, duration, onsets, v_thr, k_thr, vc, vs, kc, ks)


def stable_seed(record_id: str, source: str) -> int:
    digest = hashlib.sha256(f"BIO001-S39::{record_id}::{source}".encode()).digest()
    return int.from_bytes(digest[:8], "big") % (2**32)


def fill_channels(raw: np.ndarray) -> np.ndarray:
    out = np.asarray(raw, dtype=float).copy()
    med = np.nanmedian(out, axis=0)
    med[~np.isfinite(med)] = 0.0
    bad = ~np.isfinite(out)
    if np.any(bad):
        out[bad] = np.take(med, np.nonzero(bad)[1])
    return out


def transform_neural(rec: RecordBase, source: str) -> tuple[RecordBase, dict[str, Any]]:
    raw = fill_channels(rec.raw_selected)
    seed = stable_seed(rec.record_id, source)
    rng = np.random.default_rng(seed)
    if source == "REAL":
        transformed = raw
    elif source == "TIME_REVERSED":
        transformed = raw[::-1].copy()
    elif source == "PHASE_SCRAMBLED":
        transformed = np.empty_like(raw)
        n = raw.shape[0]
        for j in range(raw.shape[1]):
            spec = np.fft.rfft(raw[:, j])
            phases = rng.uniform(0.0, 2.0 * np.pi, size=spec.size)
            phases[0] = 0.0
            if n % 2 == 0:
                phases[-1] = 0.0
            z = np.abs(spec) * np.exp(1j * phases)
            z[0] = spec[0]
            if n % 2 == 0:
                z[-1] = spec[-1]
            transformed[:, j] = np.fft.irfft(z, n=n)
    elif source == "CHANNEL_BLOCK_PERMUTED":
        transformed = raw.copy()
        channel_block, time_block = 16, 32
        blocks = [np.arange(i, min(i + channel_block, raw.shape[1])) for i in range(0, raw.shape[1], channel_block)]
        for t0 in range(0, raw.shape[0], time_block):
            order = rng.permutation(len(blocks))
            perm = np.concatenate([blocks[i] for i in order])
            transformed[t0:t0 + time_block] = raw[t0:t0 + time_block, perm]
    else:
        raise ValueError(source)
    warm = rec.frames <= rec.warmup_boundary
    med = np.median(transformed[warm], axis=0)
    mad = np.median(np.abs(transformed[warm] - med), axis=0)
    scale = 1.4826 * mad
    scale[~np.isfinite(scale) | (scale < EPS)] = 1.0
    out = replace(rec, raw_selected=transformed, warmup_median=med, warmup_scale=scale)
    return out, {
        "source": source,
        "seed": int(seed),
        "shape": [int(x) for x in transformed.shape],
        "finite": bool(np.all(np.isfinite(transformed))),
        "offline_negative_control": source != "REAL",
    }


def align_basis(previous: np.ndarray, candidate: np.ndarray) -> np.ndarray:
    k = previous.shape[1]
    best_perm: tuple[int, ...] | None = None
    best_score = -np.inf
    for perm in itertools.permutations(range(k)):
        score = float(sum(abs(np.dot(previous[:, i], candidate[:, perm[i]])) for i in range(k)))
        if score > best_score + 1e-15 or (abs(score - best_score) <= 1e-15 and (best_perm is None or perm < best_perm)):
            best_score, best_perm = score, perm
    assert best_perm is not None
    out = candidate[:, best_perm].copy()
    for i in range(k):
        dot = float(np.dot(previous[:, i], out[:, i]))
        if dot < 0:
            out[:, i] *= -1
        elif dot == 0:
            j = int(np.argmax(np.abs(out[:, i])))
            if out[j, i] < 0:
                out[:, i] *= -1
    return out


def deterministic_basis(cov: np.ndarray, k: int, previous: np.ndarray | None = None) -> np.ndarray:
    vals, vecs = np.linalg.eigh(cov)
    basis = vecs[:, np.argsort(vals)[::-1][:k]].copy()
    for i in range(basis.shape[1]):
        j = int(np.argmax(np.abs(basis[:, i])))
        if basis[j, i] < 0:
            basis[:, i] *= -1
    return align_basis(previous, basis) if previous is not None else basis


@dataclass
class NeuralScores:
    scores: np.ndarray
    basis_updates: int


def compute_online_scores(rec: RecordBase, lam: float) -> NeuralScores:
    raw = rec.raw_selected
    warm = rec.frames <= rec.warmup_boundary
    warm_raw = np.where(np.isfinite(raw[warm]), raw[warm], rec.warmup_median[None, :])
    z_warm = (warm_raw - rec.warmup_median[None, :]) / rec.warmup_scale[None, :]
    mean = rec.warmup_median.copy()
    var = np.square(rec.warmup_scale)
    cov = np.cov(z_warm, rowvar=False, bias=True)
    basis = deterministic_basis(cov, max(KS))
    scores = np.full((rec.frames.size, max(KS)), np.nan)
    scores[warm] = z_warm @ basis
    counter = updates = 0
    for i in np.flatnonzero(~warm):
        x = np.where(np.isfinite(raw[i]), raw[i], mean)
        z = (x - mean) / np.sqrt(np.maximum(var, EPS))
        scores[i] = z @ basis
        delta = x - mean
        mean = lam * mean + (1.0 - lam) * x
        var = lam * var + (1.0 - lam) * np.square(delta)
        cov = lam * cov + (1.0 - lam) * np.outer(z, z)
        counter += 1
        if counter % RECOMPUTE_EVERY == 0:
            basis = deterministic_basis(cov, max(KS), basis)
            updates += 1
    if not np.all(np.isfinite(scores)):
        raise RuntimeError(f"nonfinite scores {rec.record_id} {lam}")
    return NeuralScores(scores, updates)


@dataclass
class EventSet:
    current_frames: np.ndarray
    reveal_frames: np.ndarray
    X: np.ndarray
    y: np.ndarray
    warmup_mask: np.ndarray
    scored_mask: np.ndarray


def behavior_features(rec: RecordBase, bs: BehaviorState, f: int) -> np.ndarray | None:
    fmap = {int(x): i for i, x in enumerate(rec.frames)}
    req = [f - lag for lag in LAGS]
    universal = req + [f - lag - 1 for lag in NEURAL_LAGS]
    if any(x not in fmap for x in universal):
        return None
    idxs = [fmap[x] for x in req]
    vz = np.asarray([(bs.v_ema[i] - bs.v_center) / bs.v_scale for i in idxs])
    kz = np.asarray([(bs.k_ema[i] - bs.k_center) / bs.k_scale for i in idxs])
    diff = np.concatenate([vz[0] - vz[1:], kz[0] - kz[1:]])
    onehot = np.zeros(len(STATES), dtype=float)
    onehot[STATES.index(str(bs.state[fmap[f]]))] = 1.0
    duration = min(int(bs.duration[fmap[f]]), 50) / 50.0
    recent10 = sum(1 for g in bs.transition_onsets if f - 10 < g <= f)
    recent20 = sum(1 for g in bs.transition_onsets if f - 20 < g <= f)
    feat = np.concatenate([vz, kz, diff, onehot, np.array([duration, recent10 / 5.0, recent20 / 10.0])])
    return feat if np.all(np.isfinite(feat)) else None


def neural_features(rec: RecordBase, scores: np.ndarray, f: int, family: str, k: int) -> np.ndarray | None:
    fmap = {int(x): i for i, x in enumerate(rec.frames)}
    req = [f - lag for lag in NEURAL_LAGS]
    if any(x not in fmap for x in req):
        return None
    if family == "PD" and any((x - 1) not in fmap for x in req):
        return None
    parts: list[np.ndarray] = []
    for x in req:
        i = fmap[x]
        s = scores[i, :k]
        parts.append(s)
        if family == "PD":
            parts.append(s - scores[fmap[x - 1], :k])
    out = np.concatenate(parts)
    return out if np.all(np.isfinite(out)) else None


def event_label(bs: BehaviorState, f: int, kind: str, horizon: int) -> int:
    for g, (_old, new) in bs.transition_onsets.items():
        if f < g <= f + horizon:
            if kind == "ANY" or (kind == "TURN" and new in ("TURN_LEFT", "TURN_RIGHT")):
                return 1
    return 0


def build_events(
    rec: RecordBase,
    bs: BehaviorState,
    endpoint: str,
    scores: np.ndarray | None = None,
    family: str | None = None,
    k: int | None = None,
) -> EventSet:
    kind, horizon = ENDPOINTS[endpoint]
    rows: list[np.ndarray] = []
    current: list[int] = []
    reveal: list[int] = []
    labels: list[int] = []
    warm: list[bool] = []
